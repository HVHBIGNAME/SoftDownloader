{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoftDownloader catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "categories", "packages"],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "updated_at": { "type": ["string", "null"] },
    "categories": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/category" } },
    "packages": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
    "https": { "type": "string", "format": "uri", "pattern": "^https://" },
    "arguments": { "type": "array", "items": { "type": "string", "pattern": "^[^\u0000]*$" } },
    "category": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
        "parent": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "publisher", "description", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }, "publisher": { "type": "string" },
        "description": { "type": "string" }, "category": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["app", "addon"], "default": "app" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "homepage": { "anyOf": [{ "$ref": "#/$defs/https" }, { "type": "null" }] },
        "enabled": { "type": "boolean", "default": true },
        "artifact": { "anyOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] },
        "source": { "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }] },
        "install": { "anyOf": [{ "$ref": "#/$defs/install" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "not": { "required": ["enabled"], "properties": { "enabled": { "const": false } } } },
          "then": {
            "required": ["install"], "properties": { "install": { "$ref": "#/$defs/install" } },
            "anyOf": [
              { "required": ["artifact"], "properties": { "artifact": { "$ref": "#/$defs/artifact" } } },
              { "required": ["source"], "properties": { "source": { "$ref": "#/$defs/source" } } }
            ]
          }
        },
        {
          "if": { "required": ["source"], "properties": { "source": { "type": "object", "required": ["type"], "properties": { "type": { "const": "website" } } } } },
          "then": { "properties": { "install": { "type": "object", "properties": { "type": { "enum": ["exe", "msi"] } } } } },
          "else": { "properties": { "artifact": { "properties": { "sha256": { "minLength": 64 }, "size": { "minimum": 1 } } } } }
        }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["file_name", "size", "sha256"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "size": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "local_path": { "type": ["string", "null"] },
        "drive_file_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{10,200}$" },
        "url": { "anyOf": [{ "$ref": "#/$defs/https" }, { "type": "null" }] }
      },
      "anyOf": [
        { "required": ["local_path"], "properties": { "local_path": { "type": "string", "minLength": 1 } } },
        { "required": ["drive_file_id"], "properties": { "drive_file_id": { "type": "string" } } },
        { "required": ["url"], "properties": { "url": { "type": "string" } } }
      ],
      "not": { "required": ["drive_file_id", "url"], "properties": { "drive_file_id": { "type": "string" }, "url": { "type": "string" } } }
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "repository", "asset_pattern"],
          "properties": {
            "type": { "const": "github" },
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "asset_pattern": { "type": "string", "maxLength": 256 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "page_url", "link_selector", "version_selector", "download_hosts"],
          "properties": {
            "type": { "const": "website" }, "page_url": { "$ref": "#/$defs/https" },
            "link_selector": { "type": "string", "minLength": 1 }, "version_selector": { "type": "string", "minLength": 1 },
            "download_hosts": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "destination": {
      "type": "object", "additionalProperties": false, "required": ["root", "path"],
      "properties": {
        "root": { "enum": ["roaming_app_data", "local_app_data", "documents"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "install": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "silent_args"],
          "properties": {
            "type": { "const": "exe" }, "silent_args": { "$ref": "#/$defs/arguments", "minItems": 1 },
            "requires_admin": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": { "const": "msi" }, "arguments": { "$ref": "#/$defs/arguments" },
            "requires_admin": { "type": "boolean", "default": true }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "destination"],
          "properties": {
            "type": { "const": "zip" }, "destination": { "$ref": "#/$defs/destination" },
            "strip_components": { "type": "integer", "minimum": 0, "maximum": 8, "default": 0 }
          }
        }
      ]
    }
  }
}
